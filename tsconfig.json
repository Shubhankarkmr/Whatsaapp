{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    
    /* Allow JS and older CommonJS modules */
    "allowJs": true,
    "esModuleInterop": true, 
    "resolveJsonModule": true,
    
    /* Type Checking */
    "strict": true,
    "skipLibCheck": true, // Essential for ignoring errors in node_modules
    
    /* File Layout */
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Remove the empty types array to allow auto-detection */
    "types": ["node"], 

    /* Recommended Options */
    "verbatimModuleSyntax": false, // Set to false to help with CommonJS imports
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": [ "declarations.d.ts"]
}